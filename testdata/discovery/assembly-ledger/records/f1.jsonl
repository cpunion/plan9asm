 apitrace. Build your Go binary\nwith\n\n\t-tags gldebug\n\nand each call to a GL function will log its input, output, and any\nerror messages. For example,\n\n\tI/GoLog   (27668): gl.GenBuffers(1) [Buffer(70001)]\n\tI/GoLog   (27668): gl.BindBuffer(ARRAY_BUFFER, Buffer(70001))\n\tI/GoLog   (27668): gl.BufferData(ARRAY_BUFFER, 36, len(36), STATIC_DRAW)\n\tI/GoLog   (27668): gl.BindBuffer(ARRAY_BUFFER, Buffer(70001))\n\tI/GoLog   (27668): gl.VertexAttribPointer(Attrib(0), 6, FLOAT, false, 0, 0)  error: [INVALID_VALUE]\n\nThe gldebug tracing has very high overhead, so make sure to remove\nthe build tag before deploying any binaries.\n*/\npackage gl\n","selection_header_sha256":"1ed97134f4486900527a29a43c40121d35ae1a68d25fdf4c01ca3eadd8308ff5"},{"file":"gl/fn.go","sha256":"de69e2e2e4ff47cf89fc95d7289bc84ef145e678abd1cccd9b4c940e202dae6c","constraint_header":"//\n//\n//\n\npackage gl\n","selection_header_sha256":"065a26da4330f6a5b98acb858577db19d2edc8801fff78a29d8d0fc59ed7c58e"},{"file":"gl/gendebug.go","sha256":"6b9bc42546959257d750f57f2a43f12ee7dff211a42d09a2be7d8536d63680e6","constraint_header":"//\n//\n//\n\n//go:build ignore\n\n//\n//\n//\npackage main\n","selection_header_sha256":"4b36077064e65b3dbac6b7b703ed213499c52e7e41b55a3aa8b756a092d84fda"},{"file":"gl/gl.go","sha256":"0c1dfbe7630ae2ba2f98e547e27c53676770bef93f7496d65befed2fe20883e5","constraint_header":"//\n//\n//\n\n//go:build (darwin || linux || openbsd || windows) \u0026\u0026 !gldebug\n\npackage gl\n","selection_header_sha256":"754e1848c8a0954a4ac22add6821ccc2db4849e9da89a8651be4c4cb24e88226"},{"file":"gl/gldebug.go","sha256":"c976223a9af3e0860e7b76bd19516c9ef9d579909ff9e0216501e6c62a65d376","constraint_header":"//\n//\n//\n\n//\n//\n\n//go:build (darwin || linux || openbsd || windows) \u0026\u0026 gldebug\n\npackage gl\n","selection_header_sha256":"c5863e4dec87b30d23397e157e0d3e401dbfc8ea02684099866ba06e9618927a"},{"file":"gl/interface.go","sha256":"655f52358087c427d5e0dc62262fb01ba009ba870bf9a1af672d0